{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/work-item-record.schema.json",
  "title": "Floati Structured Car Work Item Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "title",
    "owner",
    "artifact_bindings",
    "car_binding"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "const": "work_item"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "workspace": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))/(?:[^/]+/)*floati-work/work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "not": {
        "type": "string",
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u180E\\u200B-\\u200D\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uD800-\\uDFFF\\uFEFF\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]"
      }
    },
    "needs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
      }
    },
    "artifact_bindings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact_binding"
      }
    },
    "car_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "repository",
        "branch"
      ],
      "properties": {
        "row": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        }
      }
    }
  },
  "$defs": {
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "sha",
        "doc"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)?$"
        },
        "sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "doc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))[^/]+(?:/[^/]+)*$"
        }
      }
    }
  }
}
