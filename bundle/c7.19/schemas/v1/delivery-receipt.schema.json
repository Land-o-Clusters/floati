{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/delivery-receipt.schema.json",
  "title": "Floati Delivery Receipt v1 with Claude fallback testimony",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "recipient", "item_ids", "presentation_count", "claude_inbox"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"$ref": "../v0/delivery-receipt.schema.json#/properties/id"},
    "tenant_id": {"$ref": "../v0/delivery-receipt.schema.json#/properties/tenant_id"},
    "timestamp": {"$ref": "../v0/delivery-receipt.schema.json#/properties/timestamp"},
    "kind": {"const": "delivery_receipt"},
    "recipient": {"$ref": "../v0/delivery-receipt.schema.json#/properties/recipient"},
    "item_ids": {"allOf": [{"$ref": "../v0/delivery-receipt.schema.json#/properties/item_ids"}], "minItems": 1},
    "presentation_count": {"$ref": "../v0/delivery-receipt.schema.json#/properties/presentation_count"},
    "bridge_publication": {"$ref": "../v0/delivery-receipt.schema.json#/properties/bridge_publication"},
    "claude_inbox": {
      "type": "object", "additionalProperties": false,
      "required": ["acting_session_id", "policy_source", "fallbacks"],
      "properties": {
        "acting_session_id": {"$ref": "../v0/delivery-receipt.schema.json#/properties/bridge_publication/properties/acting_session_id"},
        "policy_source": {"const": "readable_settings_files"},
        "fallbacks": {
          "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["item_id", "code"],
            "properties": {
              "item_id": {"type": "string", "pattern": "^msg-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
              "code": {"enum": ["claude_inbox_unavailable", "claude_inbox_held", "claude_inbox_refused", "claude_inbox_unverified_version", "claude_inbox_unconfirmed"]}
            }
          }
        }
      }
    }
  },
  "allOf": [{"if": {"required": ["bridge_publication"]}, "then": {"properties": {"item_ids": {"minItems": 1}}}}]
}
