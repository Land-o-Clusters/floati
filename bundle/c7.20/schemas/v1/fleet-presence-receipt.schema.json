{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/fleet-presence-receipt.schema.json",
  "title": "Floati Fleet Presence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "tenant_id", "timestamp", "actor", "mode", "since", "away_since", "predecessor_receipt_id", "idempotency_key"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "fleet_presence_receipt"},
    "id": {"$ref": "#/$defs/receipt_id"},
    "tenant_id": {"$ref": "#/$defs/identifier"},
    "timestamp": {"$ref": "#/$defs/timestamp"},
    "actor": {"$ref": "#/$defs/identifier"},
    "mode": {"enum": ["AWAY", "PRESENT"]},
    "since": {"$ref": "#/$defs/timestamp"},
    "away_since": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "predecessor_receipt_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/receipt_id"}]},
    "idempotency_key": {"$ref": "#/$defs/identifier"}
  },
  "if": {"properties": {"away_since": {"type": "string"}}},
  "then": {"properties": {"mode": {"const": "PRESENT"}, "predecessor_receipt_id": {"type": "string"}}},
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
    "receipt_id": {"type": "string", "pattern": "^fleet-presence-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "projection": {
      "oneOf": [
        {"$ref": "#"},
        {"type": "object", "additionalProperties": false, "required": ["mode"],
         "properties": {"mode": {"const": "UNDECLARED"}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "reason"],
         "properties": {"mode": {"const": "UNKNOWN"}, "reason": {"type": "string"}}}
      ]
    }
  }
}
