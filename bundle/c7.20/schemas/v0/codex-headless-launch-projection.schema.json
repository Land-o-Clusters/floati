{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/codex-headless-launch-projection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "complete", "records"],
  "properties": {
    "schema_version": {"const": 0},
    "kind": {"const": "codex_headless_launch_projection"},
    "complete": {"type": "boolean"},
    "records": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/launch"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "native_id": {"allOf": [{"$ref": "#/$defs/identifier"}, {"not": {"pattern": "^worker-"}}]},
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "id", "dispatch_message_id", "launcher_record_id", "launcher_node_id", "launcher_provider", "launcher_session_id", "child_session_id", "cwd", "launch_requested_at", "launch_observed_at"],
      "properties": {
        "schema_version": {"const": 0},
        "kind": {"const": "codex_headless_launch"},
        "id": {"$ref": "#/$defs/identifier"},
        "dispatch_message_id": {"$ref": "#/$defs/identifier"},
        "launcher_record_id": {"$ref": "#/$defs/identifier"},
        "launcher_node_id": {"$ref": "#/$defs/identifier"},
        "launcher_provider": {"enum": ["codex", "claude"]},
        "launcher_session_id": {"$ref": "#/$defs/native_id"},
        "child_session_id": {"$ref": "#/$defs/native_id"},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "launch_requested_at": {"type": "string", "format": "date-time"},
        "launch_observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
