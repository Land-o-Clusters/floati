{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/c7.2/c7-read-bundle.schema.json",
  "title": "Floati C7.2 Read Bundle Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "title",
    "approvals",
    "reader_upgrade",
    "index_schema",
    "predecessor",
    "schema_catalog",
    "families"
  ],
  "properties": {
    "schema_version": {
      "const": "c7.2-candidate"
    },
    "kind": {
      "const": "c7_read_bundle_index"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approvals": {
      "const": "excluded-c7.2"
    },
    "reader_upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highest_understood",
        "unknown"
      ],
      "properties": {
        "highest_understood": {
          "const": true
        },
        "unknown": {
          "const": "fail_closed"
        }
      }
    },
    "index_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "file"
      ],
      "properties": {
        "id": {
          "const": "https://landoclusters.com/floati/schemas/c7.2/c7-read-bundle.schema.json"
        },
        "version": {
          "const": "c7.2-candidate"
        },
        "file": {
          "const": "schemas/c7-read-bundle.schema.json"
        }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "mutation"
      ],
      "properties": {
        "path": {
          "const": "bundle/c7.1/bundle-index.json"
        },
        "version": {
          "const": "c7.1-candidate"
        },
        "mutation": {
          "const": "forbidden"
        }
      }
    },
    "schema_catalog": {
      "const": "schema-catalog.json"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    }
  }
}
