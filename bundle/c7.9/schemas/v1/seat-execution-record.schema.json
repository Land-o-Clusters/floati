{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/seat-execution-record.schema.json",
  "description": "Native invocation/car testimony. Issuance authenticates current native source receipts and claim generations. Replay checks retained invocation continuity, whole payload idempotency and atomic envelope/readiness companions across verified archives; it does not independently reauthenticate historical source bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "node_id",
    "acting_session_id",
    "work_item_id",
    "work_claim_id",
    "invocation_id",
    "source_kind",
    "source_receipt_id",
    "source_pin",
    "source_binding",
    "workspace",
    "event",
    "code",
    "command",
    "detail",
    "envelope_id",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^seat-execution-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-floati-terminal-unsafe": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "const": "seat_execution"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-floati-terminal-unsafe": true
    },
    "acting_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-floati-terminal-unsafe": true
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "work_claim_id": {
      "type": "string",
      "pattern": "^transition-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-floati-terminal-unsafe": true
    },
    "source_kind": {
      "enum": [
        "worker",
        "cursor",
        "gateway",
        "codex_tool",
        "codex_host",
        "cursor_host",
        "desktop_host",
        "cursor_tool"
      ]
    },
    "source_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-floati-terminal-unsafe": true
    },
    "source_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_binding": {
      "oneOf": [
        {
          "const": "absent_legacy"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "attempt_id",
            "binding_record_id",
            "attempt_binding"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "x-floati-terminal-unsafe": true
            },
            "attempt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "x-floati-terminal-unsafe": true
            },
            "binding_record_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "x-floati-terminal-unsafe": true
            },
            "attempt_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "claim_id",
                "lease_id",
                "worker_session_id"
              ],
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "x-floati-terminal-unsafe": true
                },
                "claim_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "x-floati-terminal-unsafe": true
                },
                "lease_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "x-floati-terminal-unsafe": true
                },
                "worker_session_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "x-floati-terminal-unsafe": true
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_pin", "turn_id", "tool_use_id", "tool_name", "consent_receipt_id", "session_claim_id"],
          "properties": {
            "contract_pin": {"const": "8ea1e4bccb262fad05b85c300d562d2653c5a64118d6a2c5704468fc4ea836a9"},
            "turn_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-floati-terminal-unsafe": true},
            "tool_use_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-floati-terminal-unsafe": true},
            "tool_name": {"const": "Bash"},
            "consent_receipt_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-floati-terminal-unsafe": true},
            "session_claim_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-floati-terminal-unsafe": true}
          }
        },
        {"$ref": "#/$defs/permissionBinding"},
        {"$ref": "#/$defs/interruptBinding"},
        {"$ref": "#/$defs/cursorStopBinding"},
        {"$ref": "#/$defs/cursorDenialBinding"},
        {"$ref": "#/$defs/desktopHostBinding"}
      ]
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-floati-terminal-unsafe": true,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))/[^/]+(?:/[^/]+)*$"
    },
    "event": {
      "enum": [
        "running",
        "ended",
        "refused_action",
        "followup_failed",
        "unknown",
        "permission_quiet",
        "approval_pending",
        "interrupted",
        "tool_request_refused"
      ]
    },
    "code": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-floati-terminal-unsafe": true
        }
      ]
    },
    "command": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 1024, "x-floati-terminal-unsafe": true}
      ]
    },
    "detail": {
      "oneOf": [{"type": "null"}, {"type": "string", "maxLength": 8192}]
    },
    "envelope_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^msg-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-floati-terminal-unsafe": true
    }
  },
  "allOf": [
    {
      "oneOf": [
        {"properties": {"source_kind": {"const": "worker"}, "event": {"enum": ["running", "ended", "unknown"]}}},
        {"properties": {"source_kind": {"const": "cursor"}, "event": {"enum": ["running", "followup_failed", "unknown"]}}},
        {"properties": {"source_kind": {"const": "gateway"}, "event": {"enum": ["running", "refused_action", "unknown"]}}},
        {"properties": {"source_kind": {"const": "codex_tool"}, "event": {"enum": ["running", "refused_action"]}}},
        {"properties": {"source_kind": {"const": "codex_host"}, "event": {"enum": ["permission_quiet", "interrupted"]}}},
        {"properties": {"source_kind": {"const": "cursor_host"}, "event": {"const": "ended"}}},
        {"properties": {"source_kind": {"const": "cursor_tool"}, "event": {"const": "tool_request_refused"}}},
        {"properties": {"source_kind": {"const": "desktop_host"}, "event": {"enum": ["approval_pending", "ended"]}}}
      ]
    },
    {
      "if": {
        "properties": {
          "source_kind": {"enum": ["codex_host", "cursor_host", "cursor_tool", "desktop_host"]}
        }
      },
      "then": {
        "properties": {
          "code": {"type": "null"},
          "command": {"type": "null"},
          "detail": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "command": {"type": "string", "minLength": 1, "maxLength": 1024, "x-floati-terminal-unsafe": true},
          "detail": {"type": "string", "maxLength": 8192}
        },
        "allOf": [{
          "if": {"properties": {"event": {"const": "running"}}},
          "then": {"properties": {"code": {"type": "null"}, "envelope_id": {"type": "null"}}},
          "else": {"properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128, "x-floati-terminal-unsafe": true}}}
        }]
      }
    },
    {
      "oneOf": [
        {"properties": {"source_kind": {"const": "codex_tool"}, "source_binding": {"type": "object", "required": ["contract_pin", "turn_id", "tool_use_id", "tool_name", "consent_receipt_id", "session_claim_id"]}}},
        {"properties": {"source_kind": {"const": "worker"}, "source_binding": {"oneOf": [
          {"const": "absent_legacy"}, {"type": "object", "required": ["run_id", "attempt_id", "binding_record_id", "attempt_binding"]}
        ]}}},
        {"properties": {"source_kind": {"enum": ["cursor", "gateway"]}, "source_binding": {"const": "absent_legacy"}}},
        {"properties": {"source_kind": {"const": "codex_host"}}, "oneOf": [
          {"properties": {"event": {"const": "permission_quiet"}, "source_binding": {"$ref": "#/$defs/permissionBinding"}}},
          {"properties": {"event": {"const": "interrupted"}, "source_binding": {"$ref": "#/$defs/interruptBinding"}}}
        ]},
        {"properties": {"source_kind": {"const": "cursor_host"}, "source_binding": {"$ref": "#/$defs/cursorStopBinding"}}},
        {"properties": {"source_kind": {"const": "cursor_tool"}, "source_binding": {"$ref": "#/$defs/cursorDenialBinding"}}},
        {"properties": {"source_kind": {"const": "desktop_host"}, "source_binding": {"$ref": "#/$defs/desktopHostBinding"}}, "oneOf": [
          {"properties": {"event": {"const": "approval_pending"}, "source_binding": {"properties": {"notification_type": {"const": "permission_prompt"}}}}},
          {"properties": {"event": {"const": "ended"}, "source_binding": {"properties": {"notification_type": {"const": "idle_prompt"}}}}}
        ]}
      ]
    },
    {
      "if": {"properties": {"source_binding": {"type": "object", "required": ["attempt_binding"]}}},
      "then": {"properties": {"source_kind": {"const": "worker"}}}
    }
  ],
  "$defs": {
    "desktopHostBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_pin", "harness", "hook_event_name", "notification_type", "native_prompt_id", "native_timestamp", "native_event_id", "observed_at", "consent_receipt_id", "session_claim_id"],
      "properties": {
        "contract_pin": {"const": "167b2548837b5ed8163c850355fe125f8c0b6a9c81961188c807740d9e2eb952"},
        "harness": {"enum": ["claude", "grok-build", "opencode"]},
        "hook_event_name": {"enum": ["Notification", "notification", "permission.asked", "session.idle"]},
        "notification_type": {"enum": ["permission_prompt", "idle_prompt"]},
        "native_prompt_id": {"oneOf": [{"$ref": "#/$defs/identityText"}, {"type": "null"}]},
        "native_timestamp": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "native_event_id": {"oneOf": [{"$ref": "#/$defs/identityText"}, {"type": "null"}]},
        "observed_at": {"type": "string", "format": "date-time"},
        "consent_receipt_id": {"$ref": "#/$defs/identityText"},
        "session_claim_id": {"$ref": "#/$defs/identityText"}
      },
      "oneOf": [
        {"properties": {"harness": {"const": "opencode"}, "native_prompt_id": {"type": "null"}, "native_timestamp": {"type": "null"}, "native_event_id": {"$ref": "#/$defs/identityText"}}, "oneOf": [
          {"properties": {"notification_type": {"const": "permission_prompt"}, "hook_event_name": {"const": "permission.asked"}}},
          {"properties": {"notification_type": {"const": "idle_prompt"}, "hook_event_name": {"const": "session.idle"}}}
        ]},
        {"properties": {"harness": {"const": "claude"}, "hook_event_name": {"const": "Notification"}, "native_event_id": {"type": "null"}, "native_timestamp": {"type": "null"}, "native_prompt_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"}}},
        {"properties": {"harness": {"const": "grok-build"}, "hook_event_name": {"const": "notification"}, "native_event_id": {"type": "null"}, "native_timestamp": {"type": "string", "format": "date-time"}}, "oneOf": [
          {"properties": {"notification_type": {"const": "permission_prompt"}, "native_prompt_id": {"$ref": "#/$defs/identityText"}}},
          {"properties": {"notification_type": {"const": "idle_prompt"}, "native_prompt_id": {"type": "null"}}}
        ]}
      ]
    },
    "identityText": {"type": "string", "minLength": 1, "maxLength": 128, "x-floati-terminal-unsafe": true},
    "permissionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_pin", "hook_event_name", "turn_id", "observed_sequence", "observed_at", "tool_name", "consent_receipt_id", "session_claim_id"],
      "properties": {
        "contract_pin": {"const": "75c73d7a38cfc0e73ef06bd1fc506a44d25874522069ec4fb85e0bf1e7d6b8fb"},
        "hook_event_name": {"const": "PermissionRequest"},
        "turn_id": {"$ref": "#/$defs/identityText"},
        "observed_sequence": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "tool_name": {"$ref": "#/$defs/identityText"},
        "consent_receipt_id": {"$ref": "#/$defs/identityText"},
        "session_claim_id": {"$ref": "#/$defs/identityText"}
      }
    },
    "interruptBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_pin", "hook_event_name", "turn_id", "observed_sequence", "observed_at", "tool_name", "consent_receipt_id", "session_claim_id"],
      "properties": {
        "contract_pin": {"const": "be37402db3524543efe1e4058e6b9a3a53f7dd8f7791a9b75bb2accf7842196e"},
        "hook_event_name": {"const": "Interrupt"},
        "turn_id": {"$ref": "#/$defs/identityText"},
        "observed_sequence": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "tool_name": {"type": "null"},
        "consent_receipt_id": {"$ref": "#/$defs/identityText"},
        "session_claim_id": {"$ref": "#/$defs/identityText"}
      }
    },
    "cursorStopBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_pin", "cursor_version", "conversation_id", "generation_id", "loop_count", "status", "consent_receipt_id", "session_claim_id"],
      "properties": {
        "contract_pin": {"const": "044ce0931100af5fe95403e9a692b02932bc3e13a6763f576b851f503fefa518"},
        "cursor_version": {"const": "3.24.12"},
        "conversation_id": {"$ref": "#/$defs/identityText"},
        "generation_id": {"$ref": "#/$defs/identityText"},
        "loop_count": {"type": "integer", "minimum": 0},
        "status": {"enum": ["completed", "aborted", "error"]},
        "consent_receipt_id": {"$ref": "#/$defs/identityText"},
        "session_claim_id": {"$ref": "#/$defs/identityText"}
      }
    },
    "cursorDenialBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_pin", "cursor_version", "hook_event_name", "conversation_id", "generation_id", "tool_use_id", "tool_name", "failure_type", "observed_at", "consent_receipt_id", "session_claim_id"],
      "properties": {
        "contract_pin": {"const": "044ce0931100af5fe95403e9a692b02932bc3e13a6763f576b851f503fefa518"},
        "cursor_version": {"const": "3.24.12"},
        "hook_event_name": {"const": "postToolUseFailure"},
        "conversation_id": {"$ref": "#/$defs/identityText"},
        "generation_id": {"$ref": "#/$defs/identityText"},
        "tool_use_id": {"$ref": "#/$defs/identityText"},
        "tool_name": {"$ref": "#/$defs/identityText"},
        "failure_type": {"const": "permission_denied"},
        "observed_at": {"type": "string", "format": "date-time"},
        "consent_receipt_id": {"$ref": "#/$defs/identityText"},
        "session_claim_id": {"$ref": "#/$defs/identityText"}
      }
    }
  }
}
