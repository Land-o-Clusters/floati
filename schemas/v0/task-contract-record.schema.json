{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/task-contract-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "run_id", "item_id", "objective", "non_goals", "areas_to_avoid", "input_hashes", "acceptance_checks", "constraints", "risk_class", "retry_policy", "dependencies", "contract_digest"],
  "properties": {
    "schema_version": {"const": 0},
    "id": {"type": "string", "pattern": "^task-contract-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "task_contract"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "item_id": {"type": "string", "pattern": "^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
    "non_goals": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "areas_to_avoid": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["path", "region"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "region": {"type": "string", "minLength": 1, "maxLength": 1024}}}},
    "input_hashes": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "acceptance_checks": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "constraints": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "retry_policy": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "backoff"], "properties": {"max_attempts": {"type": "integer", "minimum": 1, "maximum": 32}, "backoff": {"type": "object", "additionalProperties": false, "required": ["base_delay_ms", "cap_delay_ms", "strategy"], "properties": {"base_delay_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "cap_delay_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "strategy": {"enum": ["fixed", "exponential"]}}}}},
    "dependencies": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "repository": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-](?:[A-Za-z0-9._-]{0,61}[A-Za-z0-9_-])?(?:/[A-Za-z0-9_-](?:[A-Za-z0-9._-]{0,61}[A-Za-z0-9_-])?)?$", "not": {"pattern": "[\\r\\n]"}},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
