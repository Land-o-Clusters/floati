{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/message-retracted-record.schema.json",
  "title": "Floati Message Retraction v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "retracted_message_id",
    "worker_session_id",
    "reason",
    "author"
  ],
  "properties": {
    "schema_version": {"const": 0},
    "id": {"type": "string", "pattern": "^ret-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "message_retracted"},
    "retracted_message_id": {"type": "string", "pattern": "^msg-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "worker_session_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "reason": {
      "type": "string",
      "enum": [
        "sent_in_error",
        "superseded_by_correction",
        "stale_recipient",
        "security_scrub"
      ]
    },
    "author": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
