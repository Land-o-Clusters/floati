{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://landoclusters.com/floati/schemas/v0/retry-scheduled-record.schema.json","title":"Retry scheduled record","type":"object","additionalProperties":false,"required":["schema_version","id","tenant_id","timestamp","kind","run_id","item_id","previous_attempt_id","attempt_terminal_id","next_attempt_id","next_ordinal","delay_ms","scheduler_epoch","next_fence_token"],"properties":{"schema_version":{"const":0},"id":{"type":"string","pattern":"^retry-scheduled-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},"timestamp":{"type":"string","format":"date-time"},"kind":{"const":"retry_scheduled"},"run_id":{"type":"string","pattern":"^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"item_id":{"type":"string","pattern":"^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"previous_attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"attempt_terminal_id":{"type":"string","pattern":"^attempt-terminal-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"next_attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"next_ordinal":{"type":"integer","minimum":1,"maximum":32},"delay_ms":{"type":"integer","minimum":0,"maximum":86400000},"scheduler_epoch":{"type":"integer","minimum":1,"maximum":9223372036854775807},"next_fence_token":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
