{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://landoclusters.com/floati/schemas/v0/cancel-unconfirmed-record.schema.json","type":"object","additionalProperties":false,"required":["schema_version","id","tenant_id","timestamp","kind","run_id","cancel_scope_resolved_id","item_id","attempt_id","fence_token","adapter","cancel_mode"],"properties":{"schema_version":{"const":0},"id":{"type":"string","pattern":"^cancel-unconfirmed-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},"timestamp":{"type":"string","format":"date-time"},"kind":{"const":"cancel_unconfirmed"},"run_id":{"type":"string","pattern":"^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"cancel_scope_resolved_id":{"type":"string","pattern":"^cancel-scope-resolved-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"item_id":{"type":"string","pattern":"^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"fence_token":{"type":"string","pattern":"^[0-9a-f]{64}$"},"adapter":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},"cancel_mode":{"enum":["native","local_process_only","unavailable"]}}}
