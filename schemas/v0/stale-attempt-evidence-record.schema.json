{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://landoclusters.com/floati/schemas/v0/stale-attempt-evidence-record.schema.json","type":"object","additionalProperties":false,"required":["schema_version","id","tenant_id","timestamp","kind","run_id","item_id","attempt_id","worker_receipt_ids","presented_fence_token","current_attempt_id","current_fence_token"],"properties":{"schema_version":{"const":0},"id":{"type":"string","pattern":"^stale-attempt-evidence-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},"timestamp":{"type":"string","format":"date-time"},"kind":{"const":"stale_attempt_evidence"},"run_id":{"type":"string","pattern":"^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"item_id":{"type":"string","pattern":"^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"worker_receipt_ids":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^worker-receipt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"}},"presented_fence_token":{"type":"string","pattern":"^[0-9a-f]{64}$"},"current_attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"current_fence_token":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
