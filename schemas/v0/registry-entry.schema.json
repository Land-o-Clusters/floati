{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/registry-entry.schema.json",
  "title": "Floati Registry Entry v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "node_id",
    "role",
    "state"
  ],
  "properties": {
    "schema_version": {"const": 0},
    "id": {"type": "string", "pattern": "^registry-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "registry_entry"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "role": {"type": "string", "minLength": 1, "maxLength": 64},
    "state": {"type": "string", "enum": ["active", "retired"]}
  }
}
