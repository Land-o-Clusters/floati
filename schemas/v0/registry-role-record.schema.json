{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/registry-role-record.schema.json",
  "title": "Floati Registry Role Record v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "node_id",
    "template_role",
    "template_version",
    "template_sha256",
    "answers",
    "state",
    "predecessor_role_record_id"
  ],
  "properties": {
    "schema_version": {"const": 0},
    "id": {
      "type": "string",
      "pattern": "^registry-role-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "registry_role_record"},
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "template_role": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "template_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "x-floati-terminal-unsafe": true
      }
    },
    "state": {"const": "active"},
    "predecessor_role_record_id": {
      "type": ["string", "null"],
      "pattern": "^registry-role-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    }
  }
}
