{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/declared-roots.schema.json",
  "title": "Floati Declared Roots Registry v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roots"],
  "properties": {
    "schema_version": {"const": 0},
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bus_id", "root", "architect_node", "downstream"],
        "properties": {
          "bus_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          },
          "root": {
            "type": "string",
            "pattern": "^/",
            "minLength": 2,
            "maxLength": 4096
          },
          "architect_node": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          },
          "downstream": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            }
          }
        }
      }
    }
  }
}
