{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://landoclusters.com/floati/schemas/v0/retry-exhausted-record.schema.json","title":"Retry exhausted record","type":"object","additionalProperties":false,"required":["schema_version","id","tenant_id","timestamp","kind","run_id","item_id","attempt_id","ordinal","attempt_terminal_id","max_attempts","reason_code"],"properties":{"schema_version":{"const":0},"id":{"type":"string","pattern":"^retry-exhausted-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},"timestamp":{"type":"string","format":"date-time"},"kind":{"const":"retry_exhausted"},"run_id":{"type":"string","pattern":"^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"item_id":{"type":"string","pattern":"^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"ordinal":{"type":"integer","minimum":1,"maximum":32},"attempt_terminal_id":{"type":"string","pattern":"^attempt-terminal-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"max_attempts":{"type":"integer","minimum":1,"maximum":32},"reason_code":{"const":"max_attempts"}}}
