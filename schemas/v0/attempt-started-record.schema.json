{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://landoclusters.com/floati/schemas/v0/attempt-started-record.schema.json","title":"Attempt started record","type":"object","additionalProperties":false,"required":["schema_version","id","tenant_id","timestamp","kind","run_id","item_id","attempt_id","ordinal","attempt_opened_id","dispatch_decision_id","fence_token"],"properties":{"schema_version":{"const":0},"id":{"type":"string","pattern":"^attempt-started-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},"timestamp":{"type":"string","format":"date-time"},"kind":{"const":"attempt_started"},"run_id":{"type":"string","pattern":"^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"item_id":{"type":"string","pattern":"^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"ordinal":{"type":"integer","minimum":1,"maximum":32},"attempt_opened_id":{"type":"string","pattern":"^attempt-opened-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"dispatch_decision_id":{"type":"string","pattern":"^run-dispatch-decision-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"fence_token":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
