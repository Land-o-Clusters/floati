{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/wake-cause-record.schema.json",
  "title": "Floati Wake Cause Record v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "node_id",
    "cause",
    "context_bytes",
    "wake_count"
  ],
  "properties": {
    "schema_version": {"const": 0},
    "id": {"type": "string", "pattern": "^wake-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "wake_cause"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "cause": {
      "type": "string",
      "enum": ["self_wake", "external_injection", "resurrection"]
    },
    "context_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
    "wake_count": {"type": "integer", "minimum": 1, "maximum": 1000000}
  }
}
