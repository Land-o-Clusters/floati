{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://landoclusters.com/floati/schemas/v0/attempt-opened-record.schema.json","title":"Attempt opened record","type":"object","additionalProperties":false,"required":["schema_version","id","tenant_id","timestamp","kind","run_id","item_id","attempt_id","ordinal","scheduler_epoch","fence_token","max_attempts","backoff"],"properties":{"schema_version":{"const":0},"id":{"type":"string","pattern":"^attempt-opened-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},"timestamp":{"type":"string","format":"date-time"},"kind":{"const":"attempt_opened"},"run_id":{"type":"string","pattern":"^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"item_id":{"type":"string","pattern":"^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"ordinal":{"type":"integer","minimum":1,"maximum":32},"scheduler_epoch":{"type":"integer","minimum":1,"maximum":9223372036854775807},"fence_token":{"type":"string","pattern":"^[0-9a-f]{64}$"},"max_attempts":{"type":"integer","minimum":1,"maximum":32},"backoff":{"type":"object","additionalProperties":false,"required":["strategy","base_delay_ms","cap_delay_ms","jitter"],"properties":{"strategy":{"enum":["fixed","exponential"]},"base_delay_ms":{"type":"integer","minimum":0,"maximum":86400000},"cap_delay_ms":{"type":"integer","minimum":0,"maximum":86400000},"jitter":{"const":"sha256_25pct"}}}}}
