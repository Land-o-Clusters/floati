{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://landoclusters.com/floati/schemas/v0/attempt-terminal-record.schema.json","title":"Attempt terminal record","type":"object","additionalProperties":false,"required":["schema_version","id","tenant_id","timestamp","kind","run_id","item_id","attempt_id","ordinal","attempt_started_id","fence_token","terminal_state","policy_class","reason_code","effect_safety","retry_disposition","retry_record_id","next_attempt_id","next_ordinal","retry_delay_ms","next_scheduler_epoch","next_fence_token"],"properties":{"schema_version":{"const":0},"id":{"type":"string","pattern":"^attempt-terminal-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"tenant_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},"timestamp":{"type":"string","format":"date-time"},"kind":{"const":"attempt_terminal"},"run_id":{"type":"string","pattern":"^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"item_id":{"type":"string","pattern":"^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"attempt_id":{"type":"string","pattern":"^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"ordinal":{"type":"integer","minimum":1,"maximum":32},"attempt_started_id":{"type":"string","pattern":"^attempt-started-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},"fence_token":{"type":"string","pattern":"^[0-9a-f]{64}$"},"terminal_state":{"enum":["completed","failed","cancelled","uncertain"]},"policy_class":{"type":["string","null"],"enum":["transient","permanent","operator_required","policy_refusal","cancelled","unknown_effect",null]},"reason_code":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},"effect_safety":{"enum":["idempotent","non_idempotent","unknown_effect"]},"retry_disposition":{"enum":["none","scheduled","exhausted"]},"retry_record_id":{"type":["string","null"]},"next_attempt_id":{"type":["string","null"]},"next_ordinal":{"type":["integer","null"],"minimum":1,"maximum":32},"retry_delay_ms":{"type":["intege