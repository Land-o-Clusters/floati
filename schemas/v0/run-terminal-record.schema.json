{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/run-terminal-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "run_id",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 64
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "id": {
      "type": "string",
      "pattern": "^run-terminal-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "kind": {
      "const": "run_terminal"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "skipped",
        "needs_operator",
        "uncertain",
        "partially_succeeded"
      ]
    }
  }
}
