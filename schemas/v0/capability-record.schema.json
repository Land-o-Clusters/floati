{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/capability-record.schema.json",
  "title": "Floati Capability Record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "node_id", "capability", "mode", "scope", "observed_at", "expires_at"],
  "properties": {
    "schema_version": {"const": 0},
    "id": {"type": "string", "pattern": "^capability-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "capability"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "capability": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "mode": {"type": "string", "enum": ["unavailable", "read_only", "read_write"]},
    "scope": {"type": "string", "minLength": 1, "maxLength": 512},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
