{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v0/role-template.schema.json",
  "title": "Floati Role Template v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_version",
    "role",
    "duties",
    "decision_rights",
    "stops",
    "fences",
    "cadence",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "template_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "duties": {
      "$ref": "#/$defs/copy_lines"
    },
    "decision_rights": {
      "$ref": "#/$defs/copy_lines"
    },
    "stops": {
      "$ref": "#/$defs/copy_lines"
    },
    "fences": {
      "$ref": "#/$defs/copy_lines"
    },
    "cadence": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "ask"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          },
          "ask": {
            "$ref": "#/$defs/copy_line"
          },
          "default": {
            "$ref": "#/$defs/copy_line"
          }
        }
      }
    },
    "ack_sla_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "$defs": {
    "copy_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "x-floati-terminal-unsafe": true
    },
    "copy_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/copy_line"
      }
    }
  }
}
