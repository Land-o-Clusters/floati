{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/credential-lease-granted-record.schema.json",
  "title": "Floati Credential Lease Granted Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "attempt_id", "principal", "capability", "secret_alias", "ttl_seconds", "expires_at", "authority_epoch", "authority_record_id", "capability_set_bound_id"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^credential-lease-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "credential_lease_granted"},
    "attempt_id": {"type": "string", "pattern": "^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "principal": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "capability": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "secret_alias": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "authority_record_id": {"type": "string", "pattern": "^authority-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "capability_set_bound_id": {"type": "string", "pattern": "^capability-set-bound-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"}
  }
}
