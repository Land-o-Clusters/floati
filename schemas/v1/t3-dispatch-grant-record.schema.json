{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/t3-dispatch-grant-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "tenant_id",
    "timestamp",
    "provider_instance",
    "model",
    "count",
    "expires_at",
    "idempotency_key",
    "human_act"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "t3_dispatch_grant"
    },
    "id": {
      "type": "string",
      "pattern": "^t3-grant-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "provider_instance": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 10000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "human_act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "rendered_digest"
      ],
      "properties": {
        "channel": {
          "const": "controlling_terminal"
        },
        "rendered_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
