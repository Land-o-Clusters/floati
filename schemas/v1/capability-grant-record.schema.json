{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/capability-grant-record.schema.json",
  "title": "Floati Capability Grant Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "worker_id", "capability_name", "policy_digest", "approval_request_id", "approval_decision_id", "authority_subject", "authority_epoch", "expires_at", "grant_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^capability-grant-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "capability_grant"},
    "worker_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "capability_name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_request_id": {"type": "string", "pattern": "^approval-request-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "approval_decision_id": {"type": "string", "pattern": "^approval-decision-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "authority_subject": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "authority_epoch": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "grant_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
