{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/doctor-artifact.schema.json",
  "title": "Floati Doctor Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnostic_version", "state", "root", "source", "ref", "findings", "unrecognized_kinds", "fleet_update"],
  "properties": {
    "schema_version": {"const": 1},
    "diagnostic_version": {"const": "0"},
    "state": {"enum": ["healthy", "refused", "unknown", "cannot_speak", "malformed_evidence", "degraded"]},
    "root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source": {"type": "string", "minLength": 1, "maxLength": 4096},
    "ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "unrecognized_kinds": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/unrecognized_kind"}},
    "fleet_update": {"$ref": "#/$defs/fleet_update"},
    "probe": {"$ref": "#/$defs/probe_report"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "probe_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_version", "state", "root"],
      "properties": {
        "schema_version": {"const": 1},
        "probe_version": {"const": "0"},
        "state": {"enum": ["healthy", "degraded", "refused"]},
        "root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "detail": {"type": "string", "minLength": 1},
        "budget_seconds": {"type": "number", "exclusiveMinimum": 0},
        "total_budget_seconds": {"type": "number", "minimum": 0},
        "nodes": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node", "verdict", "elapsed_ticks"],
            "properties": {
              "node": {"$ref": "#/$defs/identifier"},
              "verdict": {"enum": ["PASS", "DEAF"]},
              "elapsed_ticks": {"type": "integer", "minimum": 0}
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/probe_finding"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "refused"}}},
          "then": {"required": ["detail"]},
          "else": {
            "required": ["budget_seconds", "total_budget_seconds", "nodes", "findings"],
            "not": {"required": ["detail"]}
          }
        }
      ]
    },
    "probe_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "subject", "detail"],
      "properties": {
        "code": {"const": "delivery_probe"},
        "severity": {"enum": ["ok", "error"]},
        "subject": {"$ref": "#/$defs/identifier"},
        "detail": {"type": "string", "minLength": 1},
        "remediation": {"type": "string", "minLength": 1}
      }
    },
    "fleet_update": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["state", "actors"], "properties": {"state": {"const": "absent"}, "actors": {"$ref": "#/$defs/actors"}}},
        {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"const": "unavailable"}}},
        {"type": "object", "additionalProperties": false, "required": ["state", "code"], "properties": {"state": {"const": "integrity_failure"}, "code": {"type": "string", "pattern": "^[a-z0-9_]+$"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "actors", "operations", "actor", "started_at", "idempotency_key", "plan_digest", "consent_receipt_id", "last_completed_step_receipt_id", "completion_receipt_id", "remaining_steps", "epoch_roll_state", "current_transport_pins", "target_transport_pins", "owner_review_batch_digest", "reader_consequences", "seat_binding_consequences", "seat_exclusions"],
          "properties": {
            "state": {"enum": ["in_progress", "completed"]}, "actors": {"$ref": "#/$defs/actors"},
            "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fleet_update_operation"}},
            "actor": {"$ref": "#/$defs/identifier"}, "started_at": {"type": "string"}, "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
            "plan_digest": {"$ref": "#/$defs/sha256"}, "consent_receipt_id": {"type": "string", "pattern": "^update-consent-"},
            "last_completed_step_receipt_id": {"$ref": "#/$defs/receipt_or_null"}, "completion_receipt_id": {"$ref": "#/$defs/receipt_or_null"},
            "remaining_steps": {"type": "array", "items": {"$ref": "#/$defs/remaining_step"}}, "epoch_roll_state": {"enum": ["not_required", "required", "completed"]},
            "current_transport_pins": {"$ref": "#/$defs/transport_pins"}, "target_transport_pins": {"$ref": "#/$defs/transport_pins"},
            "owner_review_batch_digest": {"$ref": "#/$defs/sha256"},
            "reader_consequences": {"$ref": "fleet-update-receipt.schema.json#/properties/reader_consequences"},
            "seat_binding_consequences": {"$ref": "fleet-update-receipt.schema.json#/properties/seat_binding_consequences"},
            "seat_exclusions": {"$ref": "fleet-update-receipt.schema.json#/properties/seat_exclusions"}
          }
        }
      ]
    },
    "fleet_update_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "actor", "started_at", "idempotency_key", "plan_digest", "consent_receipt_id", "last_completed_step_receipt_id", "completion_receipt_id", "remaining_steps", "epoch_roll_state", "current_transport_pins", "target_transport_pins", "owner_review_batch_digest", "reader_consequences", "seat_binding_consequences", "seat_exclusions"],
      "properties": {
        "state": {"enum": ["in_progress", "completed"]}, "actor": {"$ref": "#/$defs/identifier"}, "started_at": {"type": "string"}, "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "plan_digest": {"$ref": "#/$defs/sha256"}, "consent_receipt_id": {"type": "string", "pattern": "^update-consent-"},
        "last_completed_step_receipt_id": {"$ref": "#/$defs/receipt_or_null"}, "completion_receipt_id": {"$ref": "#/$defs/receipt_or_null"},
        "remaining_steps": {"type": "array", "items": {"$ref": "#/$defs/remaining_step"}}, "epoch_roll_state": {"enum": ["not_required", "required", "completed"]},
        "current_transport_pins": {"$ref": "#/$defs/transport_pins"}, "target_transport_pins": {"$ref": "#/$defs/transport_pins"}, "owner_review_batch_digest": {"$ref": "#/$defs/sha256"},
        "reader_consequences": {"$ref": "fleet-update-receipt.schema.json#/properties/reader_consequences"},
        "seat_binding_consequences": {"$ref": "fleet-update-receipt.schema.json#/properties/seat_binding_consequences"},
        "seat_exclusions": {"$ref": "fleet-update-receipt.schema.json#/properties/seat_exclusions"}
      }
    },
    "identifier": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_or_null": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^fleet-update-"}]},
    "actors": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
    "transport_pins": {"type": "object", "additionalProperties": false, "required": ["manifest_sha256", "source_sha"], "properties": {"manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "remaining_step": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ordinal", "coordinate"],
      "properties": {"kind": {"enum": ["shared_install", "waiter_binding", "epoch_roll", "transport_pins"]}, "ordinal": {"type": "integer", "minimum": 1}, "coordinate": {"$ref": "#/$defs/step_coordinate"}}
    },
    "step_coordinate": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "destination", "metadata_relative"], "properties": {"kind": {"const": "shared_install"}, "destination": {"type": "string", "pattern": "^/"}, "metadata_relative": {"const": ".floati-install/manifest.v0.json"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "index", "configuration", "store", "trust_key"], "properties": {"kind": {"const": "waiter_binding"}, "index": {"type": "integer", "minimum": 0}, "configuration": {"type": "string", "pattern": "^/"}, "store": {"type": "string", "pattern": "^/"}, "trust_key": {"oneOf": [{"type": "null"}, {"type": "string"}]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "epoch_roll"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "registry", "transport"], "properties": {"kind": {"const": "transport_pins"}, "registry": {"type": "string", "pattern": "^/"}, "transport": {"$ref": "#/$defs/identifier"}}}
      ]
    },
    "unrecognized_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count", "first_id"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
        "count": {"type": "integer", "minimum": 1},
        "first_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "subject", "detail", "remediation"],
      "allOf": [
        {
          "if": {"properties": {"code": {"const": "delivery_health"}}},
          "then": {"required": ["oldest_unread"]},
          "else": {"not": {"required": ["oldest_unread"]}}
        },
        {
          "if": {"properties": {"code": {"const": "version_skew"}}},
          "then": {"required": ["vocabulary_skew"]},
          "else": {"not": {"required": ["vocabulary_skew"]}}
        },
        {
          "if": {"properties": {"code": {"const": "bus_epoch_roll_reconciled"}}},
          "then": {"required": ["epoch_roll"]},
          "else": {"not": {"required": ["epoch_roll"]}}
        },
        {
          "if": {"properties": {"code": {"const": "wake_health"}}},
          "then": {"required": ["wake_health"]},
          "else": {"not": {"required": ["wake_health"]}}
        },
        {
          "if": {"properties": {"code": {"const": "acknowledgment_health"}}},
          "then": {"required": ["acknowledgment"]},
          "else": {"not": {"required": ["acknowledgment"]}}
        },
        {
          "if": {
            "properties": {
              "code": {"const": "effect_reconciliation_interpreter_trust"},
              "severity": {"const": "warning"}
            }
          },
          "then": {"required": ["interpreter_trust"]},
          "else": {"not": {"required": ["interpreter_trust"]}}
        },
        {
          "if": {"required": ["hook_trust"]},
          "then": {
            "properties": {"code": {"const": "codex_wait_hook_trust"}},
            "required": [
              "hook_trust_key",
              "hook_trust",
              "hook_trust_status",
              "hook_trust_current_hash",
              "hook_trust_observed_hash",
              "hook_enabled",
              "hook_armed",
              "hook_trust_remediation"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["hook_trust_key"]},
                {"required": ["hook_trust_status"]},
                {"required": ["hook_trust_current_hash"]},
                {"required": ["hook_trust_observed_hash"]},
                {"required": ["hook_enabled"]},
                {"required": ["hook_armed"]},
                {"required": ["hook_trust_remediation"]}
              ]
            }
          }
        }
      ],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_]{0,126}[a-z0-9])?$"},
        "severity": {"enum": ["ok", "info", "warning", "error"]},
        "subject": {"type": "string", "minLength": 1, "maxLength": 4096},
        "detail": {"type": "string", "minLength": 1, "maxLength": 8192},
        "remediation": {"type": ["string", "null"], "maxLength": 4096},
        "installer_shadow": {"$ref": "fleet-status-artifact.schema.json#/$defs/installer_shadow"},
        "oldest_unread": {"$ref": "fleet-status-artifact.schema.json#/$defs/oldest_unread"},
        "vocabulary_skew": {"$ref": "#/$defs/vocabulary_skew"},
        "epoch_roll": {"$ref": "#/$defs/epoch_roll"},
        "wake_health": {"$ref": "wake-health-fact.schema.json"},
        "acknowledgment": {"$ref": "#/$defs/acknowledgment_health"},
        "interpreter_trust": {"$ref": "#/$defs/interpreter_trust"},
        "hook_trust_key": {"type": "string", "minLength": 1, "maxLength": 4096},
        "hook_trust": {"enum": ["trusted", "untrusted_pending_user"]},
        "hook_trust_status": {"enum": ["trusted", "modified", "untrusted"]},
        "hook_trust_current_hash": {"$ref": "#/$defs/sha256"},
        "hook_trust_observed_hash": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "hook_enabled": {"type": ["boolean", "null"]},
        "hook_armed": {"type": "boolean"},
        "hook_trust_remediation": {"type": ["string", "null"], "maxLength": 4096}
      }
    },
    "acknowledgment_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivered_unacknowledged_count", "oldest_attention_minutes", "oldest_message_id", "acknowledged_count", "latencies", "cadence", "sla"],
      "properties": {
        "delivered_unacknowledged_count": {"type": "integer", "minimum": 0},
        "oldest_attention_minutes": {"type": ["integer", "null"], "minimum": 0},
        "oldest_message_id": {"type": ["string", "null"], "pattern": "^msg-"},
        "acknowledged_count": {"type": "integer", "minimum": 0},
        "latencies": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/acknowledgment_latency"}},
        "cadence": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
        "sla": {"const": "undeclared"}
      }
    },
    "acknowledgment_latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "seconds"],
      "properties": {
        "message_id": {"type": "string", "pattern": "^msg-"},
        "seconds": {"type": "integer", "minimum": 0}
      }
    },
    "interpreter_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter_path", "failing_component", "component_uid", "component_mode"
      ],
      "properties": {
        "interpreter_path": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "failing_component": {"type": "string", "pattern": "^/", "maxLength": 4096},
        "component_uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "component_mode": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "epoch_roll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "tenant_id", "request", "classification", "direction", "receipt"],
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "PREPARED"}}},
          "then": {
            "properties": {
              "direction": {"const": "rollback"},
              "receipt": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"classification": {"const": "COMMITTED"}}},
          "then": {
            "properties": {
              "direction": {"const": "roll_forward"},
              "receipt": {"$ref": "bus-epoch-roll-receipt.schema.json"}
            }
          }
        }
      ],
      "properties": {
        "root": {"$ref": "#/properties/root"},
        "tenant_id": {"$ref": "bus-epoch-roll-receipt.schema.json#/properties/tenant_id"},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor", "idempotency_key", "request_id"],
          "properties": {
            "actor": {"$ref": "bus-epoch-roll-receipt.schema.json#/properties/actor"},
            "idempotency_key": {"$ref": "bus-epoch-roll-receipt.schema.json#/properties/idempotency_key"},
            "request_id": {"type": "string", "minLength": 1, "maxLength": 256, "x-floati-terminal-unsafe": true}
          }
        },
        "classification": {"enum": ["PREPARED", "COMMITTED"]},
        "direction": {"enum": ["rollback", "roll_forward"]},
        "receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "bus-epoch-roll-receipt.schema.json"}
          ]
        }
      }
    },
    "vocabulary_skew": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reader_version", "ledger_version", "unknown_kinds", "remedy", "observed_at"],
      "properties": {
        "state": {"const": "version_skew"},
        "reader_version": {"const": "0"},
        "ledger_version": {"type": "string", "pattern": "^[0-9]+$"},
        "unknown_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"}
        },
        "remedy": {"type": "string", "minLength": 1, "maxLength": 4096},
        "observed_at": {"type": "string", "pattern": "Z$"}
      }
    }
  }
}
