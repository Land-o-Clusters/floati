{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/ack-receipt.schema.json",
  "title": "Floati Actor-Bound Acknowledgment Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "timestamp",
    "kind",
    "recipient",
    "acting_session_id",
    "item_ids"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^ack-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "ack_receipt"},
    "recipient": {"type": "string", "minLength": 1, "maxLength": 64},
    "acting_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "node_lease_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^lease-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"}
      ]
    },
    "node_lease_state_at_ack": {
      "enum": ["not_leased", "active", "expired", "retired"]
    },
    "node_lease_expires_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "item_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^msg-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"}
    }
  },
  "dependentRequired": {
    "node_lease_id": ["node_lease_state_at_ack", "node_lease_expires_at"],
    "node_lease_state_at_ack": ["node_lease_id", "node_lease_expires_at"],
    "node_lease_expires_at": ["node_lease_id", "node_lease_state_at_ack"]
  }
}
