{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/fleet-status-artifact.schema.json",
  "title": "Floati Fleet Status Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "command", "status", "evidence"],
  "properties": {
    "artifact_version": {"const": 0},
    "command": {"const": "status"},
    "status": {"const": "ok"},
    "evidence": {"$ref": "#/$defs/status"}
  },
  "$defs": {
    "installer_shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "enumerated_roots", "found", "reason"],
      "properties": {
        "outcome": {"enum": ["found", "affirmative_none", "unknown", "cannot_speak"]},
        "enumerated_roots": {
          "type": "array",
          "maxItems": 4096,
          "items": {"type": "string", "pattern": "^/"}
        },
        "found": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "blocked_entry": {"type": "string", "maxLength": 4096},
        "reason": {
          "enum": [
            "A floati ahead of the installed copy answered first on PATH.",
            "Every PATH entry was checked; the installed floati answers first.",
            "Some PATH entries could not be read; shadow state unknown.",
            "No installer destination named; the shadow check could not run."
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "claimed", "completed"],
      "properties": {
        "open": {"type": "integer", "minimum": 0},
        "claimed": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "tenant", "root_source"],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "tenant": {"type": "string", "minLength": 1, "maxLength": 64},
        "root_source": {"enum": ["explicit", "environment"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "role", "liveness", "authority", "mutex", "inbox_depth", "last_activity", "oldest_unread", "wake_health"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "role": {"type": "string", "minLength": 1, "maxLength": 64},
        "liveness": {"enum": ["present", "silent", "expired", "unknown"]},
        "authority": {"enum": ["active", "expired", "none"]},
        "mutex": {"enum": ["active", "expired", "none"]},
        "inbox_depth": {"type": "integer", "minimum": 0},
        "last_activity": {"type": "string", "format": "date-time"},
        "oldest_unread": {"$ref": "#/$defs/oldest_unread"},
        "wake_health": {"$ref": "wake-health-fact.schema.json"},
        "tide": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "turnover_state"],
          "properties": {
            "policy": {"enum": ["off", "active"]},
            "turnover_state": {"enum": ["none", "directed", "state_flushed"]}
          }
        }
      }
    },
    "oldest_unread": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "age_minutes", "observed_at"],
          "properties": {
            "node": {"type": "string", "minLength": 1, "maxLength": 64},
            "age_minutes": {"type": "integer", "minimum": 0},
            "observed_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "stale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "subject_id", "holder", "epoch", "expires_at"],
      "properties": {
        "plane": {"enum": ["authority", "mutex"]},
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "holder": {"type": "string", "minLength": 1, "maxLength": 64},
        "epoch": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "work_item_id", "node_id", "adapter", "authority_subject", "authority_epoch", "artifact_bindings", "transition", "state", "outcome_code", "last_activity"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "work_item_id": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "authority_subject": {"type": "string", "minLength": 1, "maxLength": 64},
        "authority_epoch": {"type": "integer", "minimum": 1},
        "artifact_bindings": {"type": "array", "maxItems": 32, "items": {"$ref": "../v0/work-item-record.schema.json#/$defs/artifact_binding"}},
        "transition": {"enum": ["claim", "spawn", "drive", "bind_artifact", "complete", "degrade"]},
        "state": {"enum": ["claim", "driving", "complete", "degraded"]},
        "outcome_code": {"type": ["string", "null"]},
        "last_activity": {"type": "string", "format": "date-time"}
      }
    },
    "thread_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention", "observation_counts", "registered_total", "detached_total"],
      "properties": {
        "attention": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/thread_attention_waiting_on_approval"},
            {"$ref": "#/$defs/thread_attention_waiting_on_user_input"},
            {"$ref": "#/$defs/thread_attention_multiple"},
            {"$ref": "#/$defs/thread_attention_unknown"},
            {"$ref": "#/$defs/thread_attention_none"}
          ],
          "items": false
        },
        "observation_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "unknown"],
          "properties": {
            "observed": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0}
          }
        },
        "registered_total": {"type": "integer", "minimum": 0},
        "detached_total": {"type": "integer", "minimum": 0}
      }
    },
    "thread_attention_waiting_on_approval": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "count"],
      "properties": {"state": {"const": "waiting_on_approval"}, "count": {"type": "integer", "minimum": 0}}
    },
    "thread_attention_waiting_on_user_input": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "count"],
      "properties": {"state": {"const": "waiting_on_user_input"}, "count": {"type": "integer", "minimum": 0}}
    },
    "thread_attention_multiple": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "count"],
      "properties": {"state": {"const": "multiple"}, "count": {"type": "integer", "minimum": 0}}
    },
    "thread_attention_unknown": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "count"],
      "properties": {"state": {"const": "unknown"}, "count": {"type": "integer", "minimum": 0}}
    },
    "thread_attention_none": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "count"],
      "properties": {"state": {"const": "none"}, "count": {"type": "integer", "minimum": 0}}
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_schema_version", "kind", "root", "tenant_id", "scope", "mode", "observed_at", "nodes", "stale_leases", "stale_lease_count", "work_counts", "receipt_counts", "consumption", "worker_refusals", "workers", "threads", "installer_shadow", "unrecognized_kinds"],
      "properties": {
        "status_schema_version": {"const": 1},
        "kind": {"const": "fleet_status"},
        "root": {"type": "string", "pattern": "^/"},
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "scope": {"$ref": "#/$defs/scope"},
        "mode": {"const": "report_only"},
        "observed_at": {"type": "string", "format": "date-time"},
        "nodes": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/node"}},
        "stale_leases": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/stale"}},
        "stale_lease_count": {"type": "integer", "minimum": 0},
        "work_counts": {"$ref": "#/$defs/counts"},
        "receipt_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery", "ack", "denial"],
          "properties": {
            "delivery": {"type": "integer", "minimum": 0},
            "ack": {"type": "integer", "minimum": 0},
            "denial": {"type": "integer", "minimum": 0}
          }
        },
        "consumption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coordinate", "state", "wake_state", "counts"],
          "properties": {
            "coordinate": {"const": "work/items.jsonl"},
            "state": {"enum": ["work_available", "caught_up"]},
            "wake_state": {"enum": ["none", "unsatisfied_wake"]},
            "counts": {"$ref": "#/$defs/counts"}
          }
        },
        "worker_refusals": {"type": "array", "maxItems": 100000, "items": {"$ref": "../v0/worker-refusal-record.schema.json"}},
        "workers": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/worker"}},
        "threads": {"$ref": "#/$defs/thread_summary"},
        "unrecognized_kinds": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/unrecognized_kind"}},
        "installer_shadow": {"$ref": "#/$defs/installer_shadow"}
      }
    }
    ,
    "unrecognized_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count", "first_id"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
        "count": {"type": "integer", "minimum": 1},
        "first_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
