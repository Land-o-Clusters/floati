{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/run-dispatch-decision-record.schema.json",
  "title": "Floati Run Dispatch Decision Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "run_id", "item_id", "attempt_id", "eligible_workers", "chosen_worker", "capability_digest", "reason_code", "policy_digest", "routing_rank", "scheduler_epoch", "capability_set_bound_id"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^run-dispatch-decision-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "dispatch_decision"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "item_id": {"type": "string", "pattern": "^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "attempt_id": {"type": "string", "pattern": "^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "eligible_workers": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"}},
    "chosen_worker": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "capability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routing_rank": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "scheduler_epoch": {"type": "integer", "minimum": 1},
    "capability_set_bound_id": {"type": "string", "pattern": "^capability-set-bound-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "adapter": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "attempt_spawn_policy_id": {"type": "string", "pattern": "^attempt-spawn-policy-bound-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"}
  },
  "allOf": [
    {"if": {"required": ["adapter"]}, "then": {"required": ["attempt_spawn_policy_id"]}},
    {"if": {"required": ["attempt_spawn_policy_id"]}, "then": {"required": ["adapter"]}}
  ]
}
