{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/tide-receipt-record.schema.json",
  "title": "Floati Tide Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "node_id", "harness", "policy_id", "metric", "value", "threshold", "stamp", "access_class", "formula", "sources", "evaluation_state", "action", "crossing_epoch", "crossing_receipt_id", "state_flush_receipt_id", "envelope_id", "idempotency_key"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^tide-receipt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"$ref": "#/$defs/identifier"},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "tide_receipt"},
    "node_id": {"$ref": "#/$defs/identifier"},
    "harness": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_id": {"type": "string", "pattern": "^tide-policy-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "metric": {"$ref": "#/$defs/identifier"},
    "value": {"type": "string", "pattern": "^(?:0|0\\.[0-9]+|[1-9][0-9]*(?:\\.[0-9]+)?)$"},
    "threshold": {"type": "string", "pattern": "^(?:0|0\\.[0-9]+|[1-9][0-9]*(?:\\.[0-9]+)?)$"},
    "stamp": {"enum": ["MEASURED", "DERIVED", "SELF_REPORTED"]},
    "access_class": {"enum": ["A", "B"]},
    "formula": {"type": "string", "minLength": 1, "maxLength": 500},
    "sources": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "evaluation_state": {"enum": ["crossed", "recommended", "directed", "rearmed", "state_flushed"]},
    "action": {"enum": ["recommend", "direct"]},
    "crossing_epoch": {"type": "integer", "minimum": 1},
    "crossing_receipt_id": {"type": ["string", "null"], "pattern": "^tide-receipt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "state_flush_receipt_id": {"type": ["string", "null"], "pattern": "^node-state-flush-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "envelope_id": {"type": ["string", "null"], "pattern": "^msg-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"}
  }
}
