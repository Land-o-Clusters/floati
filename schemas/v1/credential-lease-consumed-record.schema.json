{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/credential-lease-consumed-record.schema.json",
  "title": "Floati Credential Lease Consumed Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "lease_id", "delivery_mode", "consumed_at_testimony"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^credential-lease-consumed-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "credential_lease_consumed"},
    "lease_id": {"type": "string", "pattern": "^credential-lease-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "delivery_mode": {"type": "string", "enum": ["inherited_fd", "helper_response"]},
    "consumed_at_testimony": {"type": "string", "format": "date-time"}
  }
}
