{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/run-segment-opened-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "segment_number", "first_global_ordinal", "previous_seal_digest", "max_records", "max_bytes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^run-segment-opened-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "segment_opened"},
    "segment_number": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "first_global_ordinal": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "previous_seal_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "max_records": {"type": "integer", "minimum": 1, "maximum": 100000},
    "max_bytes": {"type": "integer", "minimum": 65536, "maximum": 67108864}
  },
  "allOf": [
    {"if": {"properties": {"segment_number": {"const": 0}}, "required": ["segment_number"]}, "then": {"properties": {"previous_seal_digest": {"const": null}}}, "else": {"properties": {"previous_seal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  ]
}
