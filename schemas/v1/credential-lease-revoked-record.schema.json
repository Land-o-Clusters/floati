{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/credential-lease-revoked-record.schema.json",
  "title": "Floati Credential Lease Revoked Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "lease_id", "authority_epoch", "revoked_at_testimony"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^credential-lease-revoked-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "credential_lease_revoked"},
    "lease_id": {"type": "string", "pattern": "^credential-lease-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "authority_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "revoked_at_testimony": {"type": "string", "format": "date-time"}
  }
}
