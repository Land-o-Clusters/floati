{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/capability-set-bound-record.schema.json",
  "title": "Floati Capability Set Bound Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "tenant_id", "timestamp", "kind", "run_id", "item_id", "attempt_id", "fence_token", "chosen_worker", "policy_digest", "routing_rank", "evaluated_at_testimony", "grant_ledger_high_watermark", "effective_grants", "capability_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^capability-set-bound-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": "string", "format": "date-time"},
    "kind": {"const": "capability_set_bound"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "item_id": {"type": "string", "pattern": "^work-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "attempt_id": {"type": "string", "pattern": "^attempt-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
    "fence_token": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chosen_worker": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routing_rank": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "evaluated_at_testimony": {"type": "string", "format": "date-time"},
    "grant_ledger_high_watermark": {"type": "integer", "minimum": 1, "maximum": 100000},
    "effective_grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_name", "grant_id", "physical_position"],
        "properties": {
          "capability_name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
          "grant_id": {"type": "string", "pattern": "^capability-grant-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"},
          "physical_position": {"type": "integer", "minimum": 1, "maximum": 100000}
        }
      }
    },
    "capability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
