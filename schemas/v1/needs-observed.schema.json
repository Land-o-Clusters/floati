{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landoclusters.com/floati/schemas/v1/needs-observed.schema.json",
  "title": "Floati Needs-You Observed Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "id", "tenant_id", "timestamp", "actor", "item_kind",
    "statement", "coordinates", "supersedes", "event_key"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "needs_observed"},
    "id": {"$ref": "#/$defs/item_id"},
    "tenant_id": {"$ref": "#/$defs/identifier"},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"$ref": "#/$defs/identifier"},
    "item_kind": {"enum": ["review", "question"]},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "detail", "provenance"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "detail": {"type": "null"},
        "provenance": {"const": "observed"}
      }
    },
    "coordinates": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "orchestrator", "project", "thread_id", "run_id", "status",
                     "pending_requests", "background_tasks", "provenance"],
        "properties": {
          "kind": {"const": "thread"},
          "orchestrator": {"$ref": "#/$defs/identifier"},
          "project": {"$ref": "#/$defs/identifier"},
          "thread_id": {"$ref": "#/$defs/observed_identifier"},
          "run_id": {"$ref": "#/$defs/observed_identifier"},
          "status": {"type": "string", "pattern": "^[a-z][a-z_-]{0,63}$"},
          "pending_requests": {"type": "integer", "minimum": 0},
          "background_tasks": {"type": "integer", "minimum": 0},
          "provenance": {"const": "observed"}
        }
      }
    },
    "supersedes": {"anyOf": [{"$ref": "#/$defs/item_id"}, {"type": "null"}]},
    "event_key": {"$ref": "bound-record-common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "observed_identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "item_id": {"type": "string", "pattern": "^needs-item-[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"}
  }
}
