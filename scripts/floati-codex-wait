#!/usr/bin/python3
"""Shim: the installed Codex Stop waiter execs `floati wait`."""

from pathlib import Path
import sys


bundle_root = Path(__file__).resolve().parents[1]
if str(bundle_root) not in sys.path:
    sys.path.insert(0, str(bundle_root))

from floati.cli import main  # noqa: E402

WAIT_PREFIX = ["wait", "--for", "fresh-work"]


def _argv(argv: list[str]) -> list[str]:
    if argv[:3] == WAIT_PREFIX:
        return argv
    return WAIT_PREFIX + argv


if __name__ == "__main__":
    raise SystemExit(main(_argv(sys.argv[1:])))
