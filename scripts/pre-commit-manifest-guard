#!/usr/bin/env python3
"""PRE-COMMIT MANIFEST GUARD — the U2 control, moved earlier.

Ruling (msg-01a02882eeaf): "A CONTROL THAT ONLY RUNS AT THE END IS A
DETECTOR, NOT A GUARD. When a defect recurs and its machine check already
exists, the fix is never another test; it is moving the existing one
earlier." This hook runs floati.manifest.verify_manifest as the LAST
keystroke before every `git commit`.

On a git worktree, deployable paths are intersected with `git ls-files`
so untracked workspace files cannot freeze into the bundle
(AD-1 GREEN fail, tracked_set_mismatch).

Install (per clone or worktree):
    cp scripts/pre-commit-manifest-guard .git/hooks/pre-commit
    chmod +x .git/hooks/pre-commit

Worktree note: in a linked worktree, .git is a pointer FILE, so the repo
root is resolved via `git rev-parse --show-toplevel` (hooks run with CWD
at the worktree root).

Exit nonzero blocks the commit while the deployable set or digests are
stale — exactly the tracked_set_mismatch / digest_mismatch families that
bit three times.
"""
import subprocess
import sys
from pathlib import Path


def repo_root() -> Path:
    toplevel = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    return Path(toplevel)


def main() -> int:
    root = repo_root()
    sys.path.insert(0, str(root))
    from floati.manifest import verify_manifest

    errors = verify_manifest(root)
    if errors:
        for error in errors:
            print(f"MANIFEST GUARD: {error}", file=sys.stderr)
        print(
            "MANIFEST GUARD: bundle-manifest.v0.json is stale — regenerate "
            "(sorted deployable paths + sha256) and re-stage it before "
            "committing.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
