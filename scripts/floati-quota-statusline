#!/usr/bin/env python3
"""Consent-by-configuration Claude status-line quota collector."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Dict, Optional, Sequence

PACKAGE_ROOT = Path(__file__).resolve().parent.parent
if str(PACKAGE_ROOT) not in sys.path:
    sys.path.insert(0, str(PACKAGE_ROOT))

from floati.errors import DurabilityFailure, IntegrityFailure, ProtocolRefusal
from floati.quota import QuotaLedger
from floati.quota_adapters import MAX_PROVIDER_PAYLOAD_BYTES, adapter_for
from floati.root import resolve_command_root


class _Parser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise ProtocolRefusal("arguments_invalid", message)


def _artifact(status: str, evidence: Dict[str, object], *, error: bool) -> None:
    stream = sys.stderr if error else sys.stdout
    print(
        json.dumps(
            {
                "artifact_version": 0,
                "command": "quota-statusline",
                "status": status,
                "evidence": evidence,
            },
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        ),
        file=stream,
    )


def _parser() -> argparse.ArgumentParser:
    parser = _Parser(add_help=False, allow_abbrev=False)
    parser.add_argument("--root", required=True)
    parser.add_argument("--observed-at", required=True)
    parser.add_argument("--idempotency-key", required=True)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    try:
        arguments = _parser().parse_args(argv)
        payload = sys.stdin.buffer.read(MAX_PROVIDER_PAYLOAD_BYTES + 1)
        if len(payload) > MAX_PROVIDER_PAYLOAD_BYTES:
            raise ProtocolRefusal(
                "quota_payload_oversized", "Claude status-line testimony exceeds one MiB"
            )
        root = resolve_command_root(arguments.root)
        receipt = adapter_for("anthropic_claude_code").observe(
            payload,
            observed_at=arguments.observed_at,
            idempotency_key=arguments.idempotency_key,
        )
        row = QuotaLedger(root).append(receipt)
        _artifact(
            "ok",
            {
                "provider": receipt.provider,
                "receipt_digest": receipt.receipt_digest,
                "record_id": row["id"],
            },
            error=False,
        )
        return 0
    except ProtocolRefusal as exc:
        _artifact(
            "refused",
            {"code": exc.code, "detail": exc.detail, "remedy": exc.remedy},
            error=True,
        )
        return 20
    except IntegrityFailure as exc:
        _artifact(
            "malformed_evidence",
            {"code": exc.code, "detail": exc.detail},
            error=True,
        )
        return 33
    except DurabilityFailure as exc:
        _artifact(
            "degraded",
            {"code": exc.code, "detail": exc.detail},
            error=True,
        )
        return 35


if __name__ == "__main__":
    raise SystemExit(main())
